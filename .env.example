# Token du bot Discord (Developer Portal > Bot > Token).
# En local, utiliser TON PROPRE bot de test (application Discord separee) — voir README "Secrets : qui a acces a quoi".
# Ne jamais utiliser ici le token du bot de production (celui-la ne vit que sur le VPS).
DISCORD_TOKEN=

# Client ID de l'application Discord (Developer Portal > General Information)
CLIENT_ID=

# Optionnel : ID de guilde pour enregistrer les commandes slash en dev (instantané, sinon ~1h en global)
DEV_GUILD_ID=

# Optionnel, PRODUCTION UNIQUEMENT : token du CDN de stockage d'images (storage.fbfa.fr).
# Laisser vide en dev local — les images sont alors stockées en base (bytea) comme avant,
# aucun appel n'est fait vers le CDN. Ne renseigner que sur le VPS de prod.
CDN_TOKEN=

# --- Dev local sans Docker ---
# Connexion PostgreSQL directe (Prisma)
DATABASE_URL=postgresql://user:password@localhost:5432/roxwood_network

# --- Déploiement Docker Compose (VPS) ---
# Utilisés par docker-compose.yml pour construire DATABASE_URL et provisionner Postgres.
# Ne pas réutiliser ces identifiants en dev local, générer un mot de passe dédié pour le VPS.
POSTGRES_USER=roxwood_network
POSTGRES_PASSWORD=
POSTGRES_DB=roxwood_network
